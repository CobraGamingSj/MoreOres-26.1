{
  "schemaVersion": 1,
  "id": "moreores",
  "version": "${version}",
  "name": "MoreOres+",
  "description": "This mod adds new ores into your game.",
  "authors": [
    "CobraGamingSJ"
  ],
  "contact": {
    "sources": "https://github.com/CobraGamingSj/MoreOres-Fabric-26.1",
